+                })
+                .collect();
+            let all = !notes.is_empty() && notes.iter().all(|n| n["valid"] == Value::Bool(true));
+            Ok(serde_json::json!({
+                "federation_id": ecash.mint().map(|m| m.to_string()),
+                "ours": ours,
+                "amount_msat": ecash.amount().msats,
+                "valid": ours && all,
+                "notes": notes,
+            }))
+        }
