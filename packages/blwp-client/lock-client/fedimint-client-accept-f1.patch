+
+    /// BLWP (kanban #192): f + 1 identical responses - at least one honest peer among them. For an answer an honest peer
+    /// gives only once the federation's consensus has decided it (a transaction accepted), f + 1 is as safe as n - f: the
+    /// f a federation tolerates cannot make it up alone, and the client stops waiting on the slowest honest peers.
+    pub fn one_honest(num_peers: NumPeers) -> Self {
+        Self {
+            responses: BTreeMap::new(),
+            retry: BTreeSet::new(),
+            threshold: num_peers.max_evil() + 1,
+        }
+    }
