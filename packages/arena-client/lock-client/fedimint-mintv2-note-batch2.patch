 /// fails its note's check. Only then is every gathered answer checked share by share as before, the guardians with a bad
 /// share are dropped (and not asked again, as before), and the query waits for more answers. The result is the same as the
 /// stock strategy's: exactly a threshold of answers whose every share is valid. The blinded messages are computed once.
+/// BLWP kanban #192: each note's combined blinded signature, by its request's tweak (16 random bytes), from the checked batch
+/// to the output state machine that finalizes the note - taken out there, so each is used once.
+pub(crate) static COMBINED: std::sync::LazyLock<std::sync::Mutex<BTreeMap<[u8; 16], tbs::BlindedSignature>>> =
+    std::sync::LazyLock::new(|| std::sync::Mutex::new(BTreeMap::new()));
+
+/// BLWP kanban #192: a threshold of answers of the right length, unchecked - the caller checks them (one batch).
+struct GatherThreshold {
+    len: usize,
+    threshold: usize,
+    gathered: BTreeMap<PeerId, Vec<BlindedSignatureShare>>,
+}
+
+impl QueryStrategy<Vec<BlindedSignatureShare>, BTreeMap<PeerId, Vec<BlindedSignatureShare>>> for GatherThreshold {
+    fn process(
+        &mut self,
+        peer: PeerId,
+        shares: Vec<BlindedSignatureShare>,
+    ) -> QueryStep<BTreeMap<PeerId, Vec<BlindedSignatureShare>>> {
+        if shares.len() != self.len {
+            return QueryStep::Failure(ServerError::InvalidResponse(anyhow::anyhow!("Invalid number of signatures shares")));
+        }
+        self.gathered.insert(peer, shares);
+        if self.gathered.len() < self.threshold {
+            QueryStep::Continue
+        } else {
+            QueryStep::Success(std::mem::take(&mut self.gathered))
+        }
+    }
+}
