+/// BLWP kanban #192: many (blinded) signature checks in one - a random linear combination, one multi-Miller loop, one final
+/// exponentiation: e(sum r_i sig_i, -g2) * prod_pk e(sum_(i: pk) r_i msg_i, pk) == 1. With random r_i (from the OS) a single
+/// invalid signature makes the batch fail except with negligible probability, so it accepts exactly what the one-by-one
+/// checks accept; the CPU is one Miller loop per distinct key instead of two full pairings per signature.
+fn batch_check(items: impl Iterator<Item = (G1Affine, G1Affine, G2Affine)>) -> bool {
+    let mut rng = OsRng;
+    let mut sig_sum = G1Projective::identity();
+    let mut by_pk: Vec<(G2Affine, G1Projective)> = Vec::new();
+    let mut any = false;
+    for (msg, sig, pk) in items {
+        any = true;
+        // 128-bit random factors (BLWP kanban #192): half the doublings of a full scalar; a batch with a bad signature still
+        // passes only with probability 2^-128
+        let r = Scalar::from_raw([rand::RngCore::next_u64(&mut rng), rand::RngCore::next_u64(&mut rng), 0, 0]);
+        sig_sum += G1Projective::from(sig) * r;
+        match by_pk.iter_mut().find(|(p, _)| *p == pk) {
+            Some((_, acc)) => *acc += G1Projective::from(msg) * r,
+            None => by_pk.push((pk, G1Projective::from(msg) * r)),
+        }
+    }
+    if !any {
+        return true;
+    }
+    let neg_g2 = bls12_381::G2Prepared::from(-G2Affine::generator());
+    let sig_aff = sig_sum.to_affine();
+    let prepared: Vec<(G1Affine, bls12_381::G2Prepared)> =
+        by_pk.iter().map(|(pk, acc)| (acc.to_affine(), bls12_381::G2Prepared::from(*pk))).collect();
+    let mut terms: Vec<(&G1Affine, &bls12_381::G2Prepared)> = prepared.iter().map(|(a, b)| (a, b)).collect();
+    terms.push((&sig_aff, &neg_g2));
+    bls12_381::multi_miller_loop(&terms).final_exponentiation() == bls12_381::Gt::identity()
+}
+
+/// BLWP kanban #192: verify_blinded_signature for many at once (see batch_check).
+pub fn verify_blinded_signatures_batch(items: &[(BlindedMessage, BlindedSignature, AggregatePublicKey)]) -> bool {
+    batch_check(items.iter().map(|(m, s, pk)| (m.0, s.0, pk.0)))
+}
+
+/// BLWP kanban #192: verify for many at once (see batch_check).
+pub fn verify_batch(items: &[(Message, Signature, AggregatePublicKey)]) -> bool {
+    batch_check(items.iter().map(|(m, s, pk)| (m.0, s.0, pk.0)))
+}
+
+
+#[cfg(test)]
+mod blwp_batch_tests {
+    // BLWP kanban #192: the batch checks accept exactly what the one-by-one checks accept - every valid set, and no set
+    // with one wrong signature, one signature under another key, or one message swapped.
+    use bls12_381::Scalar;
+    use group::ff::Field;
+    use rand::rngs::OsRng;
+
+    use super::*;
+
+    fn key() -> (SecretKeyShare, AggregatePublicKey) {
+        let sk = SecretKeyShare(Scalar::random(&mut OsRng));
+        let pk = AggregatePublicKey(derive_pk_share(&sk).0);
+        (sk, pk)
+    }
+
+    fn sets() -> (Vec<(BlindedMessage, BlindedSignature, AggregatePublicKey)>, Vec<(Message, Signature, AggregatePublicKey)>) {
+        let keys = [key(), key()];
+        let mut blinded = Vec::new();
+        let mut plain = Vec::new();
+        for i in 0..8u8 {
+            let (sk, pk) = &keys[usize::from(i % 2)];
+            let msg = Message::from_bytes_sha256(&[i; 33]);
+            let bk = BlindingKey::random();
+            let bmsg = blind_message(msg, bk);
+            let bsig = BlindedSignature(sign_message(bmsg, *sk).0);
+            assert!(verify_blinded_signature(bmsg, bsig, *pk));
+            let sig = unblind_signature(bk, bsig);
+            assert!(verify(msg, sig, *pk));
+            blinded.push((bmsg, bsig, *pk));
+            plain.push((msg, sig, *pk));
+        }
+        (blinded, plain)
+    }
+
+    #[test]
+    fn a_valid_set_passes_both_batches() {
+        let (blinded, plain) = sets();
+        assert!(verify_blinded_signatures_batch(&blinded));
+        assert!(verify_batch(&plain));
+        assert!(verify_batch(&[]));
+    }
+
+    #[test]
+    fn one_bad_signature_fails_the_batch() {
+        for bad in 0..8 {
+            let (mut blinded, mut plain) = sets();
+            blinded[bad].1 = blinded[(bad + 1) % 8].1;
+            plain[bad].1 = plain[(bad + 1) % 8].1;
+            assert!(!verify_blinded_signatures_batch(&blinded), "a wrong blinded signature at {bad} passed");
+            assert!(!verify_batch(&plain), "a wrong signature at {bad} passed");
+        }
+    }
+
+    #[test]
+    fn a_signature_under_another_key_or_a_swapped_message_fails() {
+        let (mut blinded, mut plain) = sets();
+        blinded[3].2 = blinded[4].2;
+        plain[3].2 = plain[4].2;
+        assert!(!verify_blinded_signatures_batch(&blinded));
+        assert!(!verify_batch(&plain));
+        let (blinded, mut plain) = sets();
+        plain[5].0 = Message::from_bytes_sha256(b"another");
+        assert!(verify_blinded_signatures_batch(&blinded));
+        assert!(!verify_batch(&plain));
+    }
+}
