+/// BLWP kanban #178: the spendable notes under a key prefix as (denomination, raw key), unsorted (ascending as the store
+/// keeps them) or descending - exactly the order the typed reads give. A note key is the record prefix byte, then the
+/// note's consensus encoding, whose first field is the denomination as one plain byte; nothing else is decoded here.
+async fn blwp_raw_notes(dbtx: &mut DatabaseTransaction<'_>, prefix: &[u8], descending: bool) -> Vec<(Denomination, Vec<u8>)> {
+    use fedimint_core::db::IDatabaseTransactionOpsCore;
+    let stream = if descending {
+        dbtx.raw_find_by_prefix_sorted_descending(prefix).await
+    } else {
+        dbtx.raw_find_by_prefix(prefix).await
+    }
+    .expect("reading the client's own notes");
+    stream.map(|(key, _)| (Denomination(key[1]), key)).collect::<Vec<_>>().await
+}
+
+/// BLWP kanban #178: one chosen note decoded in full, with every check of the typed read (the signature point's
+/// subgroup check, the keypair).
+fn blwp_decode_note(raw: &[u8]) -> SpendableNote {
+    let note = <SpendableNoteKey as fedimint_core::db::DatabaseKey>::from_bytes(
+        raw,
+        &fedimint_core::module::registry::ModuleDecoderRegistry::default(),
+    )
+    .expect("a spendable note key this client wrote")
+    .0;
+    debug_assert_eq!(note.denomination, Denomination(raw[1]));
+    note
+}
