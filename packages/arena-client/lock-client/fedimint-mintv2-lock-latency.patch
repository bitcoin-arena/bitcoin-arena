+    #[test]
+    fn a_note_keys_second_byte_is_its_denomination_and_it_decodes_whole() {
+        let sig = tbs::Signature(bls12_381::G1Affine::generator());
+        for d in 0..42u8 {
+            let note = SpendableNote { denomination: Denomination(d), keypair: Keypair::new(SECP256K1, &mut rand::thread_rng()), signature: sig };
+            let raw = SpendableNoteKey(note.clone()).to_bytes();
+            assert_eq!(raw[0], SpendableNotePrefix.to_bytes()[0]);
+            assert_eq!(&raw[..2], &SpendableNoteAmountPrefix(Denomination(d)).to_bytes()[..], "the amount prefix is the key's first two bytes");
+            assert_eq!(raw[1], d);
+            assert_eq!(blwp_decode_note(&raw), note);
+        }
