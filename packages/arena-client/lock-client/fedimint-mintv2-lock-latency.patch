+/// A THRESHOLD OF VALID BLIND SIGNATURE SHARES, CHECKED ONCE PER NOTE (BLWP kanban #178, 2026-10-05 option 1).
+///
+/// The stock strategy (FilterMapThreshold + verify_blind_shares) checks every share of every guardian with its own
+/// pairing as it arrives: threshold x notes share checks. This one gathers a threshold of answers (each of the right
+/// length), combines the threshold's shares of each note and checks that ONE blinded signature against the federation's
+/// aggregate key. The combination is valid only if the shares are (Lagrange over exactly the threshold), so a bad share
+/// fails its note's check. Only then is every gathered answer checked share by share as before, the guardians with a bad
+/// share are dropped (and not asked again, as before), and the query waits for more answers. The result is the same as the
+/// stock strategy's: exactly a threshold of answers whose every share is valid. The blinded messages are computed once.
+struct CombinedShareThreshold {
+    requests: Vec<NoteIssuanceRequest>,
+    messages: Vec<BlindedMessage>,
+    tbs_pks: BTreeMap<Denomination, BTreeMap<PeerId, PublicKeyShare>>,
+    agg_pks: BTreeMap<Denomination, AggregatePublicKey>,
+    gathered: BTreeMap<PeerId, Vec<BlindedSignatureShare>>,
+    threshold: usize,
+}
+
+impl CombinedShareThreshold {
+    /// `agg_pks`: the federation's aggregate key per denomination from the client's config (the key the notes are checked
+    /// against in the output state machine), not rebuilt from the key shares here.
+    fn new(
+        requests: Vec<NoteIssuanceRequest>,
+        tbs_pks: BTreeMap<Denomination, BTreeMap<PeerId, PublicKeyShare>>,
+        agg_pks: BTreeMap<Denomination, AggregatePublicKey>,
+        num_peers: fedimint_core::NumPeers,
+    ) -> Self {
+        let messages = requests.iter().map(NoteIssuanceRequest::blinded_message).collect();
+        Self { requests, messages, tbs_pks, agg_pks, gathered: BTreeMap::new(), threshold: num_peers.threshold() }
+    }
+
+    /// Every note's combined signature over exactly these answers is valid.
+    fn combined_valid(&self, chosen: &BTreeMap<PeerId, Vec<BlindedSignatureShare>>) -> bool {
+        self.requests.iter().enumerate().all(|(i, request)| {
+            let agg = tbs::aggregate_signature_shares(
+                &chosen.iter().map(|(peer, shares)| (peer.to_usize() as u64, shares[i])).collect(),
+            );
+            tbs::verify_blinded_signature(self.messages[i], agg, self.agg_pks[&request.denomination])
+        })
+    }
+
+    /// The stock check of one guardian's answer: each share against its key share.
+    fn shares_valid(&self, peer: PeerId, shares: &[BlindedSignatureShare]) -> bool {
+        self.requests.iter().zip(self.messages.iter()).zip(shares.iter()).all(|((request, message), share)| {
+            let pk = self
+                .tbs_pks
+                .get(&request.denomination)
+                .expect("No pk shares found for denomination")
+                .get(&peer)
+                .expect("No pk share found for peer");
+            tbs::verify_signature_share(*message, *share, *pk)
+        })
+    }
+}
+
+impl QueryStrategy<Vec<BlindedSignatureShare>, BTreeMap<PeerId, Vec<BlindedSignatureShare>>> for CombinedShareThreshold {
+    fn process(
+        &mut self,
+        peer: PeerId,
+        shares: Vec<BlindedSignatureShare>,
+    ) -> QueryStep<BTreeMap<PeerId, Vec<BlindedSignatureShare>>> {
+        if shares.len() != self.requests.len() {
+            return QueryStep::Failure(ServerError::InvalidResponse(anyhow::anyhow!("Invalid number of signatures shares")));
+        }
+        self.gathered.insert(peer, shares);
+        if self.gathered.len() < self.threshold {
+            return QueryStep::Continue;
+        }
+        let chosen: BTreeMap<_, _> = self.gathered.iter().take(self.threshold).map(|(p, s)| (*p, s.clone())).collect();
+        if self.combined_valid(&chosen) {
+            return QueryStep::Success(chosen);
+        }
+        // a bad share among them: the stock check, answer by answer; the bad ones are dropped for good
+        let bad: Vec<PeerId> = self.gathered.iter().filter(|(p, s)| !self.shares_valid(**p, s)).map(|(p, _)| *p).collect();
+        for p in &bad {
+            self.gathered.remove(p);
+        }
+        if self.gathered.len() >= self.threshold {
+            QueryStep::Success(self.gathered.iter().take(self.threshold).map(|(p, s)| (*p, s.clone())).collect())
+        } else {
+            QueryStep::Continue
+        }
+    }
+}
