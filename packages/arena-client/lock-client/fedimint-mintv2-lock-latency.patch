+#[cfg(test)]
+mod combined_share_tests {
+    use std::collections::{BTreeMap, BTreeSet};
+
+    use bls12_381::{G2Affine, G2Projective, Scalar};
+    use fedimint_api_client::query::{QueryStep, QueryStrategy};
+    use fedimint_core::{NumPeersExt, PeerId};
+    use fedimint_derive_secret::DerivableSecret;
+    use fedimint_mintv2_common::{Denomination, verify_note};
+    use tbs::{AggregatePublicKey, BlindedSignatureShare, PublicKeyShare, SecretKeyShare, derive_pk_share, sign_message};
+
+    use super::CombinedShareThreshold;
+    use crate::NoteIssuanceRequest;
+
+    // a 5-of-7 key from a fixed polynomial, as a dealer would split it
+    const POLY: [u64; 5] = [11, 22, 33, 44, 55];
+    fn sk(peer: u16) -> SecretKeyShare {
+        let x = Scalar::from(u64::from(peer) + 1);
+        SecretKeyShare(POLY.iter().map(|c| Scalar::from(*c)).rev().reduce(|acc, c| acc * x + c).unwrap())
+    }
+    fn agg_pk() -> AggregatePublicKey {
+        AggregatePublicKey(G2Affine::from(G2Projective::generator() * Scalar::from(POLY[0])))
+    }
+    fn peers() -> BTreeSet<PeerId> {
+        (0..7u16).map(PeerId::from).collect()
+    }
+    fn requests() -> Vec<NoteIssuanceRequest> {
+        let root = DerivableSecret::new_root(b"blwp #178", b"combined share check");
+        (0..3u8).map(|i| NoteIssuanceRequest::new(Denomination(i), [i; 16], &root)).collect()
+    }
+    fn pks(reqs: &[NoteIssuanceRequest]) -> BTreeMap<Denomination, BTreeMap<PeerId, PublicKeyShare>> {
+        reqs.iter().map(|r| (r.denomination, peers().into_iter().map(|p| (p, derive_pk_share(&sk(p.to_usize() as u16)))).collect())).collect()
+    }
+    fn honest(reqs: &[NoteIssuanceRequest], peer: u16) -> Vec<BlindedSignatureShare> {
+        reqs.iter().map(|r| sign_message(r.blinded_message(), sk(peer))).collect()
+    }
+    fn strategy(reqs: &[NoteIssuanceRequest]) -> CombinedShareThreshold {
+        CombinedShareThreshold::new(reqs.to_vec(), pks(reqs), reqs.iter().map(|r| (r.denomination, agg_pk())).collect(), peers().to_num_peers())
+    }
+    // what the output state machine does with the result: combine, unblind, check against the aggregate key
+    fn notes_valid(reqs: &[NoteIssuanceRequest], got: &BTreeMap<PeerId, Vec<BlindedSignatureShare>>) -> bool {
+        reqs.iter().enumerate().all(|(i, r)| {
+            let agg = tbs::aggregate_signature_shares(&got.iter().map(|(p, s)| (p.to_usize() as u64, s[i])).collect());
+            verify_note(r.finalize(agg).note(), agg_pk())
+        })
+    }
+
+    #[test]
+    fn five_honest_answers_are_taken_and_make_valid_notes() {
+        let reqs = requests();
+        let mut s = strategy(&reqs);
+        for p in 0..4u16 {
+            assert!(matches!(s.process(PeerId::from(p), honest(&reqs, p)), QueryStep::Continue));
+        }
+        let QueryStep::Success(got) = s.process(PeerId::from(4), honest(&reqs, 4)) else { panic!("no success at the fifth") };
+        assert_eq!(got.keys().copied().collect::<Vec<_>>(), (0..5u16).map(PeerId::from).collect::<Vec<_>>());
+        assert!(notes_valid(&reqs, &got));
+    }
+
+    #[test]
+    fn a_bad_share_fails_its_note_and_its_guardian_is_dropped() {
+        let reqs = requests();
+        // guardian 2 answers note 1 with a share signed under guardian 6's key: a bad share
+        let mut bad = honest(&reqs, 2);
+        bad[1] = sign_message(reqs[1].blinded_message(), sk(6));
+        let mut chosen: BTreeMap<PeerId, Vec<BlindedSignatureShare>> = (0..5u16).filter(|p| *p != 2).map(|p| (PeerId::from(p), honest(&reqs, p))).collect();
+        chosen.insert(PeerId::from(2), bad.clone());
+        let s = strategy(&reqs);
+        assert!(!s.combined_valid(&chosen), "the combined check fails with the bad share in it");
+        assert!(!notes_valid(&reqs, &chosen), "and the note it would make is invalid");
+
+        let mut s = strategy(&reqs);
+        for p in [0u16, 1, 3] {
+            assert!(matches!(s.process(PeerId::from(p), honest(&reqs, p)), QueryStep::Continue));
+        }
+        assert!(matches!(s.process(PeerId::from(2), bad), QueryStep::Continue));
+        // the fifth answer: the combined check fails, guardian 2 is found and dropped, four valid are left - wait
+        assert!(matches!(s.process(PeerId::from(4), honest(&reqs, 4)), QueryStep::Continue));
+        let QueryStep::Success(got) = s.process(PeerId::from(5), honest(&reqs, 5)) else { panic!("no success at the sixth") };
+        assert!(!got.contains_key(&PeerId::from(2)), "the bad guardian is not in the result");
+        assert_eq!(got.len(), 5);
+        assert!(notes_valid(&reqs, &got));
+    }
+
+    #[test]
+    fn an_answer_of_the_wrong_length_is_refused() {
+        let reqs = requests();
+        let mut s = strategy(&reqs);
+        let mut short = honest(&reqs, 0);
+        short.pop();
+        assert!(matches!(s.process(PeerId::from(0), short), QueryStep::Failure(_)));
+    }
+}
