#!/bin/bash
# ARENA NODE ON macOS: THE APP'S HELPER (2026-10-19: "a small gui version of the installer that launches the browser"). "Bitcoin
# Arena.app" from bitcoin-arena-node-<version>-darwin-<arch>.dmg is a native app (pkg/macos/App.swift): it sits in
# the Dock, with the running dot, while the installer runs (kanban #635, the owner's playtest 2026-10-25: "doesn't stay open, doesn't have an
# icon that indicates that it is running"), and asks this script, beside it in Contents/Resources, for each step:
#   start   copy the release out of the app to ~/Library/BitcoinArena/<release> - the node's services run it from there, never from the disk
#           image or an app macOS may move (App Translocation) - take its quarantine mark off, then print one line: "installed" (a node
#           is set up), "running <link>" (an installer runs already) or "started <link>" (it started one, in the background); or fails
#   prepare / launch / wait-link   the same in three steps, so the app shows a progress window between them (the owner's playtest
#           2026-10-25: "Wenn ich BitcoinArena.App öffne passiert erstmal gar nichts bis der Browser öffnet"): prepare copies and
#           answers installed / running <link> / ready; launch starts the installer; wait-link answers its link, "waiting", or fails
#   state   "running", "done" (the installer says Done or a node is set up) or "ended <its last lines>"
#   newer   for an installed node: "<node's version> <this app's version>" when this app carries a newer release, else nothing
#   update  the installed node moved to this app's release (arena-install --update-self): its progress lines as they come,
#           "[#####-----]  45 %  Unpacking 2026.1.9.9" (kanban #706), then one line, "Updated: ..." or why not
#           (the owner's playtest 2026-10-25: "When I execute 2.9.2 it doesn't update the node, it just starts the 1.9.1")
#   link    the installer's one-time link        stop     stop the installer
#   status  `bitcoinarena status`                 owner    open the owner page       restart   restart the node
#   node    the node in one line (bitcoinarena state: running / stopped)   dashboard   the node's dashboard in the browser
#   node-start / node-stop   start or stop the node's services          doctor      `bitcoinarena doctor`
# Built-in parts only (bash, osascript): nothing more to install.
APP="$(cd "$(dirname "$0")/../.." && pwd)"
# THE NAMES SINCE 2026.1.9.8 (kanban #688, 2026-10-26: "Rename the directories and binaries to bitcoinarena, not arenanode everywhere in the
# installer, the packages etc."): ~/Library/BitcoinArena, the node in ~/.bitcoinarena, the command bitcoinarena. What an older app set up
# stays where it is and is found there - the release copies in ~/Library/ArenaNode, the node in ~/.arena-node (its services run from them),
# the command arenanode until the node's update writes bitcoinarena (instance.js homeDefault, launchers.js writeCommand)
BASE="$HOME/Library/BitcoinArena"
[ -d "$BASE" ] || [ ! -d "$HOME/Library/ArenaNode" ] || BASE="$HOME/Library/ArenaNode"
holds() { [ -f "$1/state.json" ] || [ -f "$1/arena.conf" ]; }
H="$HOME/.bitcoinarena"
if ! holds "$H" && holds "$HOME/.arena-node"; then H="$HOME/.arena-node"; fi
# the node's command carries its instance (arena.conf instance=4: bitcoinarena-4), as the installer names it - the bare name only without one
# (playtest 2026-10-25: a fourth node on the MacBook, the app looked for arenanode, "No such file or directory", and Go did nothing)
INST=$(sed -n 's/^instance=//p' "$H/arena.conf" 2>/dev/null | head -1)
CMD="$H/bin/bitcoinarena${INST:+-$INST}"
[ -x "$CMD" ] || [ ! -x "$H/bin/arenanode${INST:+-$INST}" ] || CMD="$H/bin/arenanode${INST:+-$INST}"
LOG="$BASE/installer.log"
PIDF="$BASE/installer.pid"; LINKF="$BASE/installer.link"

installed() { [ -x "$CMD" ] && [ -f "$H/arena.conf" ]; }
running() { [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null; }
stop_it() { running && kill "$(cat "$PIDF")" 2>/dev/null; rm -f "$PIDF"; }
release() {
  SRC=$(ls -d "$APP/Contents/Resources/release/"*arena-node-* 2>/dev/null | head -1)
  [ -n "$SRC" ] || { echo "This app holds no Bitcoin Arena release. Download the disk image again." >&2; exit 1; }
  DEST="$BASE/$(basename "$SRC")"
  if [ ! -x "$DEST/runtime/node" ]; then
    mkdir -p "$BASE" && rm -rf "$DEST.part" && cp -R "$SRC" "$DEST.part" && mv "$DEST.part" "$DEST" || { echo "Could not copy the node to $BASE." >&2; exit 1; }
    xattr -dr com.apple.quarantine "$DEST" 2>/dev/null
  fi
}

launch() {
  : > "$LOG"
  ARENA_NO_BROWSER=1 ARENA_CLOUDFLARED="$DEST/runtime/cloudflared" nohup "$DEST/runtime/node" "$DEST/packages/arena-installer/bin/arena-install.mjs" >> "$LOG" 2>&1 < /dev/null &
  echo $! > "$PIDF"; rm -f "$LINKF"
}
# one look for the installer's link: printed once it is there, "waiting" while it starts, a failure once it has ended without one
wait_link() {
  LINK=$(grep -oE 'https?://[^ ]+\?t=[A-Za-z0-9_-]+' "$LOG" 2>/dev/null | head -1)
  if [ -n "$LINK" ]; then echo "$LINK" > "$LINKF"; echo "$LINK"; return 0; fi
  if running; then echo waiting; return 0; fi
  rm -f "$PIDF"; echo "The installer did not start: $(tail -3 "$LOG")" >&2; return 1
}

case "${1:-}" in
  prepare)
    release
    if running; then echo "running $(cat "$LINKF" 2>/dev/null)"; exit 0; fi
    if installed; then echo installed; exit 0; fi
    echo ready ;;
  launch) release; launch; echo launched ;;
  wait-link) wait_link || exit 1 ;;
  start)
    release
    if running; then echo "running $(cat "$LINKF" 2>/dev/null)"; exit 0; fi
    if installed; then echo installed; exit 0; fi
    launch
    for _ in $(seq 1 60); do L=$(wait_link) || exit 1; [ "$L" != waiting ] && { echo "started $L"; exit 0; }; sleep 1; done
    stop_it; echo "The installer did not start within a minute: $(tail -3 "$LOG")" >&2; exit 1 ;;
  state)
    if grep -q '^Done\. Your node runs' "$LOG" 2>/dev/null; then rm -f "$PIDF"; echo done
    elif running; then echo running
    elif installed; then rm -f "$PIDF"; echo done
    else rm -f "$PIDF"; echo "ended $(tail -3 "$LOG" 2>/dev/null)"; fi ;;
  newer)
    release
    "$DEST/runtime/node" --input-type=module -e '
      import { readFileSync } from "node:fs";
      const [h, mine] = process.argv.slice(1);
      const { newerVersion } = await import(mine + "/packages/arena-node/src/release-latest.js");
      const v = (d) => { try { return readFileSync(d + "/VERSION", "utf8").trim(); } catch { return null; } };
      let from = null; try { from = JSON.parse(readFileSync(h + "/state.json", "utf8")).release.path; } catch {}
      const have = from ? v(from) : null, own = v(mine);
      if (from && from !== mine && own && (!have || newerVersion(own, have))) console.log((have || "an older release") + " " + own);' "$H" "$DEST" 2>/dev/null ;;
  update)
    release
    ARENA_CLOUDFLARED="$DEST/runtime/cloudflared" "$DEST/runtime/node" "$DEST/packages/arena-installer/bin/arena-install.mjs" --update-self --home "$H" 2>&1 | grep --line-buffered -E '^(\[[#-]+\] |Updated|Up to date|Rolled back|Not updated)' ;;
  link) cat "$LINKF" 2>/dev/null ;;
  stop) stop_it ;;
  status) "$CMD" status 2>&1 | head -24 ;;
  owner) "$CMD" open >/dev/null 2>&1 ;;
  restart) "$CMD" restart >/dev/null 2>&1 ;;
  node) "$CMD" state 2>&1 | head -1 ;;
  dashboard) "$CMD" dashboard >/dev/null 2>&1 ;;
  node-start) "$CMD" start 2>&1 | tail -3 ;;
  node-stop) "$CMD" stop 2>&1 | tail -3 ;;
  doctor) "$CMD" doctor 2>&1 | head -30 ;;
  *) echo "usage: bitcoin-arena-app prepare|launch|wait-link|start|newer|update|state|link|stop|status|owner|restart|node|dashboard|node-start|node-stop|doctor" >&2; exit 2 ;;
esac
