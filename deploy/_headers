# THE .unityweb FILES ARE BROTLI, AND SAID TO BE (kanban #265, measured 2026-10-08 on the same build, MacBook Chrome as an
# Android phone at 10x CPU): without Content-Encoding the loader decompressed the wasm and data in JavaScript after the last
# byte and only then compiled - 962 ms from the download's end to running wasm; with it the browser decompresses natively and
# compiles while it downloads - 106 ms, and 90 -> 100 % fell from 3,026 to 2,056 ms. Cloudflare passes the header through and
# the body unpacks to the wasm magic. The types are said again here so the wasm keeps application/wasm (streaming compile).
/Build/*.wasm.unityweb
  Content-Encoding: br
  Content-Type: application/wasm
/Build/*.js.unityweb
  Content-Encoding: br
  Content-Type: application/javascript
/Build/*.data.unityweb
  Content-Encoding: br
  Content-Type: application/octet-stream

# The streamed models are content-hashed, so they can be cached hard.
/ServerData/*
  Cache-Control: public, max-age=31536000, immutable
